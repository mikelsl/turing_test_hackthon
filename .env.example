# Turing MindGames Arena local config

# Telegram playable frontend
# Use a fresh BotFather bot for this Mantle/Turing submission. Do not reuse any previous hackathon bot.
TURING_TELEGRAM_BOT_TOKEN=
# Legacy fallback only; prefer TURING_TELEGRAM_BOT_TOKEN for this project.
TELEGRAM_BOT_TOKEN=

# LLM provider — submitted demo target is GLM.
# Direct Z.ai: LLM_BACKEND=zai, ZAI_API_KEY=..., ZAI_MODEL=glm-4.5
# Free OpenRouter GLM fallback: LLM_BACKEND=openrouter-glm-speech, OPENROUTER_API_KEY=..., LLM_MODEL=z-ai/glm-4.5-air:free
LLM_BACKEND=openrouter-glm-speech
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-4.5
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=z-ai/glm-4.5-air:free
LLM_TEMPERATURE=0.95
LLM_MAX_TOKENS=420
LLM_MIN_REQUEST_INTERVAL_MS=0

# Mantle Sepolia
# mock = local only; mantle-sepolia = write game/action/finalization events on Mantle Sepolia
MANTLE_BACKEND=mock
MANTLE_RPC_URL=https://rpc.sepolia.mantle.xyz
MANTLE_PRIVATE_KEY=
# Current Mantle Sepolia demo deployment (public addresses; safe to commit)
AGENT_REGISTRY_ADDRESS=0x4aDe976Ce967917d5263754f8F733B39151FE898
AGENT_ACTION_REGISTRY_ADDRESS=0xa432db727D908fFAEDEB51Aaec5A753357eb5704
GAME_SETTLEMENT_VAULT_ADDRESS=0xFbadd57084612223aA4D24eA61d7EBe7d470A35E
# Keep low while faucet balance is limited; 0 means record all actions
MANTLE_RECORD_ACTION_LIMIT=2

# Telegram wager UX — local/private env only; never commit real private keys.
TELEGRAM_WAGER_ENABLED=0
TELEGRAM_WAGER_BOND_MNT=0.001
TELEGRAM_WAGER_MIN_AGENT_GAS_MNT=0.02
TELEGRAM_WAGER_AGENT_FUND_MNT=0.03
# Optional safety allowlist for chats/users allowed to spend live demo wallets; comma-separated Telegram chat IDs/user IDs.
TELEGRAM_WAGER_ALLOWED_CHAT_IDS=
# Optional override; otherwise MANTLE_PRIVATE_KEY/PRIVATE_KEY acts as operator/human demo wallet.
TELEGRAM_WAGER_OPERATOR_PRIVATE_KEY=
# Comma-separated five demo agent private keys, mapped to Ada/Charm/Riot/Shade/Mira.
AGENT_WALLET_PRIVATE_KEYS=

# Local artifacts/dashboard
ARTIFACTS_DIR=./artifacts
UPDATE_LATEST_REPLAY=true
